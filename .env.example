# =============================================================================
#  ERPNext en Docker - variables de entorno
#  Copia este archivo a ".env" (install.sh lo hace automáticamente) y ajusta.
#
#  No hace falta tocar NADA para una instalación normal: los valores por defecto
#  funcionan. Edítalo sólo si quieres cambiar algo (por ejemplo el puerto 8080,
#  los años fiscales o poner tu propia contraseña).
# =============================================================================

# --- Stack --------------------------------------------------------------------
COMPOSE_PROJECT_NAME=erpnext
ERPNEXT_VERSION=v16.51.1
RESTART_POLICY=unless-stopped

# --- Puertos / red ------------------------------------------------------------
# Único puerto publicado en el host. La app queda en http://localhost:${HTTP_PORT}
HTTP_PORT=8080
UPSTREAM_REAL_IP_ADDRESS=127.0.0.1
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=off
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m

# --- Sitio --------------------------------------------------------------------
# Nombre interno del sitio (una sola empresa). Puerto 8080 -> este sitio.
SITE_NAME=frontend

# --- Credenciales (install.sh las genera al azar si están vacías) --------------
# Usuario del escritorio: Administrator
SITE_ADMIN_PASSWORD=
# Clave root de MariaDB
DB_ROOT_PASSWORD=

# --- Recursos -----------------------------------------------------------------
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
DB_BUFFER_POOL=512M

# --- Contabilidad (usado por 'install.sh contabilidad') -----------------------
# País -> determina el plan de cuentas (Chart of Accounts) que se crea.
COUNTRY=Guatemala
# Moneda funcional de la empresa
CURRENCY=GTQ
# Empresa a configurar. Déjalo VACÍO: el script detecta la empresa que creaste
# con el asistente web. Sólo llena esto si tu sitio llega a tener varias empresas.
COMPANY_NAME=
COMPANY_ABBR=
# Inventario perpetuo: 0 = apagado (recomendado para empezar), 1 = encendido.
ERP_PERPETUAL_INVENTORY=0
# Plan de cuentas mínimo: 1 = conservar la nomenclatura base de Guatemala (las 7
# raíces 1 Activos, 2 Pasivos, 3 Patrimonio, 4 Ingresos, 5 Costos, 6 Gastos y
# 7 Otros Gastos y Productos Financieros, más sus encabezados: Activo Corriente,
# No Corriente, Pasivo Corriente/No Corriente, Capital, Productos, Servicios,
# Costo de Ventas, etc.) y borrar el resto de subcuentas, para que armes tu
# propia estructura. 0 = conservar el catálogo completo "Guatemala - Cuentas".
# Sólo se aplica si la empresa todavía no tiene asientos registrados.
ERP_MINIMAL_CHART=1
# Mes de inicio del ejercicio fiscal (1 = enero, 7 = julio...)
FISCAL_YEAR_START_MONTH=1
# Años fiscales a crear (separados por coma)
FISCAL_YEARS=2025,2026,2027

# --- Libros contables (usado por 'install.sh reports') ------------------------
# Primer número de folio del Libro Diario. Úsalo para continuar la numeración
# de un libro ya emitido (por ejemplo 251). Deja vacío para empezar en 1.
LD_FOLIO_INICIO=
